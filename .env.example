# ==============================================================================
# AIR EVENTS MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Hướng dẫn:
# 1. Sao chép file này thành '.env' hoặc '.env.local' trong thư mục air-events-app/
# 2. Điền các giá trị thực tế tương ứng với môi trường chạy (Development / Staging / Production).
# 3. Không bao giờ commit file chứa secrets (Private Key, JWT Secret) lên Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH ỨNG DỤNG FRONTEND (REACT + VITE)
# ------------------------------------------------------------------------------

# Cổng khởi chạy máy chủ phát triển Vite Development Server (Mặc định: 5173)
VITE_PORT=5173

# Tiêu đề hiển thị trên thanh tiêu đề trình duyệt (Browser Tab Title)
VITE_APP_TITLE="AIR Events - Hệ Thống Quản Lý Sự Kiện & Giải Đấu Robotics"

# Chế độ chạy Offline / Mock LocalStorage
# - true:  Ứng dụng hoạt động độc lập 100%, tự lưu dữ liệu sự kiện vào LocalStorage trình duyệt
# - false: Ứng dụng gửi HTTP REST API trực tiếp đến Backend Server
VITE_ENABLE_MOCK_STORAGE=true

# Tiền tố khóa lưu trữ LocalStorage khi chạy ở chế độ Mock
VITE_STORAGE_PREFIX="air_events_"

# URL máy chủ Backend API (khi VITE_ENABLE_MOCK_STORAGE=false)
# Ví dụ local: http://localhost:3000/api/events
# Ví dụ production: https://manager.airobot.edu.vn/api/events
VITE_API_URL=http://localhost:3000/api/events

# Bật ghi log chi tiết cho các thao tác lưu trữ, Excel import/export và Chat
VITE_DEBUG_MODE=false


# ------------------------------------------------------------------------------
# 2. CẤU HÌNH MÁY CHỦ BACKEND & CƠ SỞ DỮ LIỆU (NEXT.JS + MONGOOSE)
# ------------------------------------------------------------------------------

# Chuỗi kết nối MongoDB (Mặc định local: mongodb://127.0.0.1:27017/air)
MongoDB_URI=mongodb://127.0.0.1:27017/air

# Khóa bí mật ký và giải mã JWT Token (dùng cho xác thực người dùng và phân quyền)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-air-events-2026"

# Tên cookie chứa JWT Token
token="sys1"


# ------------------------------------------------------------------------------
# 3. CẤU HÌNH TÍCH HỢP GOOGLE DRIVE STORAGE (LƯU TRỮ HÌNH ẢNH & FILE SỰ KIỆN)
# ------------------------------------------------------------------------------

# Email Service Account của Google Cloud Project
GOOGLE_CLIENT_EMAIL="air-drive-sa@your-gcp-project-id.iam.gserviceaccount.com"

# Mã Project ID trên Google Cloud Console
GOOGLE_PROJECT_ID="air-manager-system-prod"

# Khóa bí mật Google Private Key (dạng PEM: "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n")
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC7rE...YOUR_PRIVATE_KEY_HERE...\n-----END PRIVATE KEY-----\n"

# Thư mục gốc lưu trữ sự kiện và khóa học trên Google Drive
# Chuẩn AIR: mọi thư mục sự kiện/lớp học đều nằm trong thư mục gốc này
DRIVE_COURSE_FOLDER_ID="1syIZ0XYkmnYCYnQ6TRw1eCTgvKTuBZtR"

# Thư mục lưu trữ Avatar người dùng và nhân sự sự kiện
DRIVE_AVT_FOLDER_ID="18yX2w3v4u5t6s7r8q9p0o1n2m3l4k5j"

# Thư mục lưu trữ ảnh bìa banner và hình ảnh sự kiện
DRIVE_COURSE_IMAGE_FOLDER_ID="19zY3x4w5v6u7t8s9r0q1p2o3n4m5l6k"

# Các mẫu URL Google Drive CDN phục vụ hiển thị ảnh nhanh
NEXT_PUBLIC_DRIVE_THUMBNAIL_URL="https://lh3.googleusercontent.com/d/{fileId}=w800"
NEXT_PUBLIC_DRIVE_PREVIEW_URL="https://drive.google.com/file/d/{fileId}/preview"
NEXT_PUBLIC_DRIVE_DOWNLOAD_URL="https://drive.google.com/uc?export=download&id={fileId}"


# ------------------------------------------------------------------------------
# 4. CẤU HÌNH GỬI THÔNG BÁO ZALO OFFICIAL ACCOUNT (ZALO ZNS & BROADCAST)
# ------------------------------------------------------------------------------

# App ID Zalo Developers
ZALO_OA_APP_ID="1234567890123456"

# Secret Key của ứng dụng Zalo
ZALO_OA_SECRET="your-zalo-oa-app-secret-key"

# Access Token Zalo OA (được cấp qua OAuth 2.0)
ZALO_OA_ACCESS_TOKEN="your-zalo-oa-access-token"

# Refresh Token để tự động gia hạn Access Token
ZALO_REFRESH_TOKEN="your-zalo-oa-refresh-token"

# Mã ZNS Template cho thông báo điều phối nhân sự sự kiện
ZALO_TEMPLATE_STAFF_DISPATCH="zns_tpl_staff_dispatch_01"

# Mã ZNS Template cho thông báo nhắc lịch sự kiện đến phụ huynh/học sinh
ZALO_TEMPLATE_EVENT_REMINDER="zns_tpl_event_reminder_01"


# ------------------------------------------------------------------------------
# 5. CẤU HÌNH CHIA SẺ & BẢO MẬT (PUBLIC SHARING & CORS)
# ------------------------------------------------------------------------------

# Danh sách domain được phép gọi API (phân cách bằng dấu phẩy)
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,https://events.airobot.edu.vn"

# Thời hạn hiệu lực của link chia sẻ công khai (tính bằng ngày, 0 là vĩnh viễn)
SHARE_LINK_EXPIRY_DAYS=30
